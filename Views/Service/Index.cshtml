@model IList<AcunMedyaHospitalProject.Entities.Service>
@{
    ViewBag.Title = "Service List";
    Layout = "~/Views/AdminLayout/Index.cshtml";
}

<div class="col-lg-12 grid-margin stretch-card">
    <div class="card">
        <div class="card-body">
            <h4 class="card-title">Hizmetler Tablosu</h4>
            <div class="table-responsive">
                <table class="table table-hover">
                    <thead>
                        <tr>
                            <th>Id</th>
                            <th>Ad</th>
                            <th>Açıklama</th>
                            <th>İkon</th>
                            <th>Buton Adı</th>
                            <th>Buton Linki</th>
                            <th>Güncelle</th>
                            <th>Kaldır</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model)
                        {
                            <tr>
                                <td>@item.Id</td>
                                <td>@item.Name</td>
                                <td>@item.Description</td>
                                <td>@item.IconName</td>
                                <td>@item.ButtonName</td>
                                <td>@item.ButtonLink</td>
                                <td><a class="btn btn-success" href="/Service/UpdateService/@item.Id">Güncelle</a></td>
                                <td><a class="btn btn-danger" href="/Service/RemoveService/@item.Id">Kaldır</a></td>
                            </tr>
                        }
                    </tbody>
                </table>
                <a class="btn btn-secondary" href="/Service/CreateService">Yeni Servis Ekle</a>
            </div>
        </div>
    </div>
</div>
