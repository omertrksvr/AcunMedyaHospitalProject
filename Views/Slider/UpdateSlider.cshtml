@model AcunMedyaHospitalProject.Entities.Slider
@{
    ViewBag.Title = "Slider Güncelle";
    Layout = "~/Views/AdminLayout/Index.cshtml";
}

<div class="col-lg-12 grid-margin stretch-card">
    <div class="card">
        <div class="card-body">
            <h4 class="card-title">Slider Güncelle</h4>
            <form asp-action="UpdateSlider" method="post">
                <input type="hidden" asp-for="Id" />

                <div class="form-group">
                    <label for="exampleInputTitle">Başlık: </label>
                    <input type="text" asp-for="Title" class="form-control" />
                    <span class="text-danger">@Html.ValidationMessageFor(x => x.Title)</span>
                </div>
                <div class="form-group">
                    <label for="exampleInputDescription">Açıklama: </label>
                    <input type="text" asp-for="Description" class="form-control" />
                    <span class="text-danger">@Html.ValidationMessageFor(x => x.Description)</span>
                </div>
                <div class="form-group">
                    <label for="exampleInputImageUrl">Resim URL: </label>
                    <input type="text" asp-for="ImageUrl" class="form-control" />
                    <span class="text-danger">@Html.ValidationMessageFor(x => x.ImageUrl)</span>
                </div>

                <button type="submit" class="btn btn-primary mr-2">Güncelle</button>
                <a href="@Url.Action("Index", "Slider")" class="btn btn-secondary">İptal</a>
            </form>
        </div>
    </div>
</div>
