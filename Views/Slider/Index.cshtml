@model IList<AcunMedyaHospitalProject.Entities.Slider>
@{
    ViewBag.Title = "Slider List";
    Layout = "~/Views/AdminLayout/Index.cshtml";
}

<div class="col-lg-12 grid-margin stretch-card">
    <div class="card">
        <div class="card-body">
            <h4 class="card-title">Sliderlar Tablosu</h4>
            <div class="table-responsive">
                <table class="table table-hover">
                    <thead>
                        <tr>
                            <th>Id</th>
                            <th>Başlık</th>
                            <th>Açıklama</th>
                            <th>Resim URL</th>
                            <th>Güncelle</th>
                            <th>Kaldır</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model)
                        {
                            <tr>
                                <td>@item.Id</td>
                                <td>@item.Title</td>
                                <td>@item.Description</td>
                                <td>@item.ImageUrl</td>
                                <td><a class="btn btn-success" href="/Slider/UpdateSlider/@item.Id">Güncelle</a></td>
                                <td><a class="btn btn-danger" href="/Slider/RemoveSlider/@item.Id">Kaldır</a></td>
                            </tr>
                        }
                    </tbody>
                </table>
                <a class="btn btn-secondary" href="/Slider/CreateSlider">Yeni Slider Ekle</a>
            </div>
        </div>
    </div>
</div>
